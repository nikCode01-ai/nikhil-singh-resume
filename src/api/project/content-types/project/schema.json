{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Portfolio projects"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "app-design",
        "website-design",
        "dashboard",
        "wireframe",
        "repository"
      ],
      "required": true
    },
    "tags": {
      "type": "json"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "longDescription": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "url": {
      "type": "string"
    },
    "githubUrl": {
      "type": "string"
    },
    "demoUrl": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "tech": {
      "type": "json"
    },
    "features": {
      "type": "json"
    },
    "impact": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": ["completed", "in-progress", "planned"],
      "default": "completed",
      "required": true
    },
    "client": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "teamSize": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "required": true
    },
    "methodologies": {
      "type": "json"
    },
    "challenges": {
      "type": "json"
    },
    "solutions": {
      "type": "json"
    },
    "results": {
      "type": "json"
    },
    "testimonials": {
      "type": "json"
    },
    "metrics": {
      "type": "json"
    }
  }
}
